{
  "name": "pi-opencode-free",
  "version": "0.1.0",
  "description": "Zero-daemon, pure-passthrough native Pi extension connecting directly to OpenCode Zen API",
  "type": "module",
  "private": true,
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test src/",
    "test:node": "npm run build && node --test \"dist/**/*.test.js\"",
    "smoke": "bun scripts/smoke-real.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^24.0.0"
  }
}
