{
  "name": "pi-opencode-free",
  "version": "0.1.0",
  "description": "Zero-daemon, pure-passthrough native Pi extension connecting directly to OpenCode Zen API",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "files": [
    "dist",
    "!dist/*.test.*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./dist/index.js"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "test": "bun test src/",
    "smoke": "bun scripts/smoke-real.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^24.0.0"
  }
}
